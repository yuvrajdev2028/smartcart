# LLM Configuration
LLM_PROVIDER=gemini          # openai | gemini
LLM_MODEL=gemini-2.0-flash   # model name for the chosen provider
LLM_API_KEY=your-api-key-here

# Embedding Configuration
EMBEDDING_PROVIDER=local                # local | openai | gemini
EMBEDDING_MODEL=all-MiniLM-L6-v2       # model name for the chosen provider

# Vector Store
CHROMA_PERSIST_DIR=./chroma_data

# CORS
CORS_ORIGINS=["http://localhost:5173"]
